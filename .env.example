# Copy to .env.local. Generate real values with: node scripts/create-users.mjs sofie anna tom

# Signs session cookies. At least 32 random characters.
SESSION_SECRET=

# Login accounts as userId:salt:scryptHash, comma separated. Never put plain passwords here.
AUTH_USERS=

# Optional: Gemini routes free-text questions to a topic. Without it, keyword matching is used.
GEMINI_API_KEY=

# Recommended in production: shared state for logouts, rate limits and votes (Upstash Redis, Vercel Marketplace).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production without Upstash refuses sessions and rate-limited routes (fail closed).
# Set to "true" only on purpose, for a single-instance demo; per-instance memory weakens logout and rate limits.
ALLOW_MEMORY_STORE=false

# Set to "off" to disable "Continue as guest" (read-only demo access).
GUEST_ACCESS=

# Anthropic API key: Claude models for claim extraction (claude-haiku-5-5, claude-sonnet-5-5).
ANTHROPIC_API_KEY=

# ElevenLabs: the desktop mascot listens (speech-to-text) and talks back (text-to-speech). Voice id is optional.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Desktop mascot: a real account lets it teach the brain from your email, Teams and meetings (mascot/.env at repo root).
# Without these it signs in as the read-only guest and only checks. The user must exist in AUTH_USERS on the server.
BRAIN_USER=
BRAIN_PASSWORD=

# Demo only: let the mascot switch between people on one computer. Format label:user:password;label:user:password
DEMO_ACCOUNTS=
